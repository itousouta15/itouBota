# Discord（Developer Portal → 你的應用程式）
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=

# 指令註冊範圍：填了 GUILD_ID 就只註冊到該伺服器（立即生效，適合測試）；
# 留空則註冊為全域指令（可能需要幾分鐘～一小時生效）
GUILD_ID=

# Vercel KV / Upstash（與官網 .env.local 相同的那組）
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 擁有者的 Discord user ID（只有這個人能用 /碎碎念）
OWNER_ID=

# 生日提醒要發到哪個頻道（Discord 頻道 ID）
BIRTHDAY_CHANNEL_ID=

# （可選）發完碎碎念後通知官網即時更新 /thoughts 頁面
# 例如 https://itousouta15.tw/api/revalidate，密鑰需與 Vercel 上的 REVALIDATE_SECRET 一致
SITE_REVALIDATE_URL=
REVALIDATE_SECRET=
